# CipherH Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!

NODE_ENV=production

# ===========================================
# GitHub Token (REQUIRED for auto-commit features)
# ===========================================
# Create token at: https://github.com/settings/tokens
# Required scopes: repo (full control of repositories)
# Used for: Auto-commit bug fixes, self-modification, git sync
# 
# Choose ONE of these variable names (both work):
GITHUB_TOKEN=
# GITHUB_PERSONAL_ACCESS_TOKEN=
#
# Example format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# See GITHUB_TOKEN_SETUP.md for detailed setup guide

# ===========================================
# OpenAI Integration (REQUIRED for AI features)
# ===========================================
# Get key from: https://platform.openai.com/api-keys
# Used for: Autonomous debugging, code generation, learning
OPENAI_API_KEY=

# ===========================================
# Notion Integration (REQUIRED for memory storage)
# ===========================================
# Create integration at: https://www.notion.so/my-integrations
# Used for: Long-term memory, learning persistence
NOTION_TOKEN=

# ===========================================
# Telegram Bot (OPTIONAL - for notifications)
# ===========================================
# Create bot via @BotFather on Telegram
# Get chat ID by sending /start to your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ===========================================
# Facebook Integration (OPTIONAL)
# ===========================================
# Get long-lived page access token from Facebook Graph API
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ===========================================
# Session Secret (REQUIRED for production)
# ===========================================
# Generate a random string (use: openssl rand -base64 32)
SESSION_SECRET=

# ===========================================
# Git Workflow Configuration (OPTIONAL)
# ===========================================
# See GIT_WORKFLOW_OPTIONS.md for details
# GIT_WORKFLOW_MODE=pull-request    # direct | pull-request | hybrid
# GIT_TARGET_BRANCH=main
# AUTO_MERGE_THRESHOLD=90
# CREATE_DRAFT_PR=false
