# CipherH Environment Variables - PLACEHOLDER VALUES ONLY
# Replace all values below with your actual credentials before deployment

NODE_ENV=production

# Server Configuration
PORT=3000
HEARTBEAT_CRON=*/10 * * * *

# GitHub Auto-Sync (Optional - for auto-sync to GitHub)
# Create token at: https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenAI Integration (Required for AI features)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Notion Integration (Required for memory storage)
# Create integration at: https://www.notion.so/my-integrations
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Telegram Bot (Optional - for notifications)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Session Secret (Required for production - generate random string)
SESSION_SECRET=
